{
  "version": 1,
  "metadataSchema": [
    {
      "key": "title",
      "label": "Title",
      "type": "string",
      "required": true
    },
    {
      "key": "status",
      "label": "Status",
      "type": "string",
      "required": true,
      "allowedValues": [
        "draft",
        "review",
        "approved",
        "published",
        "deprecated"
      ]
    },
    {
      "key": "owner",
      "label": "Owner",
      "type": "string",
      "required": true
    },
    {
      "key": "audience",
      "label": "Audience",
      "type": "string",
      "required": true
    },
    {
      "key": "platform",
      "label": "Platform",
      "type": "string",
      "required": true
    },
    {
      "key": "type",
      "label": "Topic Type",
      "type": "string",
      "required": true,
      "allowedValues": [
        "concept",
        "task",
        "reference"
      ],
      "description": "DITA topic type: concept (explanations/architecture), task (ordered procedures/how-tos), or reference (APIs/schemas/tables)."
    }
  ],
  "outputDirectory": "out",
  "defaultTopicDirectory": "topics",
  "defaultImageDirectory": "images"
}
